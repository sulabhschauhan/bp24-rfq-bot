# Copy to .env and fill in. Never commit real values.

# --- Meta WhatsApp Cloud API ---
# Token you choose; Meta echoes it back during webhook verification
WHATSAPP_VERIFY_TOKEN=
# Permanent/system-user access token for sending messages
WHATSAPP_ACCESS_TOKEN=
# ID of the WhatsApp business phone number
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID
WHATSAPP_WABA_ID=

# --- Snowflake ---
# Account identifier, e.g. orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Azure Cache for Redis ---
# e.g. rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=
